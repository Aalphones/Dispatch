#!/usr/bin/env php
<?php declare(strict_types=1);

// Lokale Kommandozeile (ADR-002/ADR-006): läuft nie auf dem Server.

use Dispatch\Auth\Scopes;
use Dispatch\Db\Connection;
use Dispatch\Db\Migrator;
use Dispatch\Domain\Actor;
use Dispatch\Domain\CategoryService;
use Dispatch\Domain\DomainError;
use Dispatch\Domain\MediaService;
use Dispatch\Domain\PostService;
use Dispatch\Domain\ReactionService;
use Dispatch\Domain\Seeder;
use Dispatch\Domain\TokenService;
use Dispatch\OAuth\ClientRegistry;
use Dispatch\Site\Builder;

if (PHP_SAPI !== 'cli') {
    exit(1);
}

const DEMO_COLORS = ['#1a5fb4', '#0b7a75', '#c2410c', '#7c3aed', '#be185d', '#4d7c0f', '#b45309', '#0e7490'];

/**
 * Legt Kategorien und Artikel aus bin/demo/ an und gibt die Artikel frei.
 *
 * @param array<string, mixed> $config
 */
function runDemo(PDO $pdo, array $config, string $demoDir, bool $force): void
{
    $existingPosts = (int) $pdo->query('SELECT COUNT(*) FROM posts')->fetchColumn();
    if ($existingPosts > 0 && !$force) {
        throw new RuntimeException('Es gibt schon Artikel. Demo nur auf leerer Datenbank (php bin/dispatch demo --force legt trotzdem an).');
    }
    if (!extension_loaded('gd')) {
        throw new RuntimeException('Die PHP-Erweiterung gd fehlt; sie erzeugt die Demo-Bilder.');
    }

    $demo = require $demoDir . '/demo.php';
    $categoryIds = demoCategories(new CategoryService($pdo, $config), $demo['categories']);

    $posts = new PostService($pdo, $config);
    $media = new MediaService($pdo, $config);
    $imageNumber = 0;
    $postIds = [];

    foreach ($demo['posts'] as $entry) {
        $postIds[] = demoPost($posts, $media, $entry, $demoDir, $imageNumber);
    }

    // Nur Demo: Freigaben am selben Tag würden die Sortierung nicht zeigen.
    $spread = $pdo->prepare('UPDATE posts SET published_at = UTC_TIMESTAMP() - INTERVAL ? DAY WHERE id = ?');
    foreach ($postIds as $index => $postId) {
        $spread->execute([$index * 3, $postId]);
    }
}

/**
 * @param list<array<string, mixed>> $categories Eltern vor Kindern
 * @return array<string, int> Slug → ID
 */
function demoCategories(CategoryService $service, array $categories): array
{
    $ids = [];
    foreach ($categories as $category) {
        $fields = $category;
        $parentSlug = $fields['parent'] ?? null;
        unset($fields['parent']);
        if ($parentSlug !== null) {
            $fields['parent_id'] = $ids[$parentSlug];
        }

        try {
            $record = $service->get($fields['slug']);
        } catch (DomainError) {
            $record = $service->create($fields, Actor::owner())['category'];
        }
        $ids[$fields['slug']] = (int) $record['id'];
    }

    return $ids;
}

/**
 * @param array<string, mixed> $entry
 * @return int ID des freigegebenen Artikels
 */
function demoPost(PostService $posts, MediaService $media, array $entry, string $demoDir, int &$imageNumber): int
{
    $storeImage = static function (bool $isPortrait) use ($media, $entry, &$imageNumber): string {
        $imageNumber++;
        $record = $media->store(
            demoBild($imageNumber, DEMO_COLORS[$imageNumber % count(DEMO_COLORS)], $isPortrait),
            [
                'alt' => sprintf('Farbverlauf mit der Aufschrift „DISPATCH Demo %d“', $imageNumber),
                'caption' => sprintf('Demo-Bild %d zum Artikel „%s“', $imageNumber, $entry['title']),
                'credit' => 'DISPATCH Demo',
                'license' => 'CC0 1.0',
                'license_url' => 'https://creativecommons.org/publicdomain/zero/1.0/',
            ],
            'owner',
            Actor::cli()
        );

        return (string) $record['uid'];
    };

    $coverUid = $storeImage(false);
    $html = (string) file_get_contents($demoDir . '/' . $entry['file'] . '.html');
    foreach ($entry['bilder'] as $position => $isPortrait) {
        $html = str_replace('{{bild' . ($position + 1) . '}}', $storeImage($isPortrait), $html);
    }

    $input = array_diff_key($entry, ['file' => true, 'bilder' => true]);
    $input['cover_media_uid'] = $coverUid;
    $input['content_html'] = $html;

    try {
        $postId = (int) $posts->create($input, Actor::cli())['post']['id'];
        $posts->submit($postId, Actor::cli());
        $posts->approve($postId, Actor::owner());
    } catch (DomainError $error) {
        // Der Demo-Text ist dann falsch, nicht die Formprüfung.
        fwrite(STDERR, json_encode($error->details, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_PRETTY_PRINT) . PHP_EOL);

        throw new RuntimeException($entry['file'] . ': ' . $error->getMessage());
    }

    echo $posts->get($postId)['slug'], PHP_EOL;

    return $postId;
}

/**
 * Liest KEY=VALUE-Zeilen (ohne Kommentare, ohne Anführungszeichen um den Wert).
 *
 * @return array<string, string>
 */
function readDeployEnv(string $path): array
{
    if (!is_file($path)) {
        throw new RuntimeException('deploy.env fehlt im Repo-Wurzelverzeichnis. Vorlage: deploy.env.example.');
    }

    $values = [];
    foreach (file($path, FILE_IGNORE_NEW_LINES) ?: [] as $line) {
        $line = trim($line);
        if ($line === '' || str_starts_with($line, '#') || !str_contains($line, '=')) {
            continue;
        }
        [$key, $value] = explode('=', $line, 2);
        $values[trim($key)] = trim(trim($value), '"\'');
    }

    return $values;
}

/**
 * Ruft POST /dispatch/api/tokens auf (Deploy-Token aus deploy.env).
 *
 * @param array<string, mixed> $payload
 * @return array{result: array<string, mixed>, baseUrl: string}
 */
function callTokenEndpoint(string $deployEnvPath, array $payload): array
{
    return callDeployEndpoint($deployEnvPath, '/dispatch/api/tokens', $payload);
}

/**
 * @param array<string, mixed> $payload nur bei POST gesendet
 * @return array{result: array<string, mixed>, baseUrl: string}
 */
function callDeployEndpoint(string $deployEnvPath, string $path, array $payload, string $method = 'POST'): array
{
    $env = readDeployEnv($deployEnvPath);
    foreach (['PUBLIC_BASE_URL', 'DISPATCH_DEPLOY_TOKEN'] as $key) {
        if (($env[$key] ?? '') === '') {
            throw new RuntimeException('In deploy.env fehlt ' . $key . '.');
        }
    }
    if (!extension_loaded('curl')) {
        throw new RuntimeException('Die PHP-Erweiterung curl fehlt; --remote braucht sie.');
    }

    $baseUrl = rtrim($env['PUBLIC_BASE_URL'], '/');
    $curl = curl_init($baseUrl . $path);
    curl_setopt_array($curl, [
        CURLOPT_CUSTOMREQUEST => $method,
        CURLOPT_HTTPHEADER => [
            'Authorization: Bearer ' . $env['DISPATCH_DEPLOY_TOKEN'],
            'Content-Type: application/json',
        ],
        CURLOPT_RETURNTRANSFER => true,
        CURLOPT_TIMEOUT => 30,
    ]);
    if ($method === 'POST') {
        curl_setopt($curl, CURLOPT_POSTFIELDS, json_encode($payload, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR));
    }
    $body = curl_exec($curl);
    $status = (int) curl_getinfo($curl, CURLINFO_RESPONSE_CODE);
    $curlError = curl_error($curl);

    if ($body === false) {
        throw new RuntimeException('Der Server ist nicht erreichbar: ' . $curlError);
    }
    if ($status === 204) {
        return ['result' => [], 'baseUrl' => $baseUrl];
    }
    $result = json_decode((string) $body, true);
    if (!is_array($result)) {
        throw new RuntimeException(sprintf('Unerwartete Antwort vom Server (HTTP %d).', $status));
    }
    if ($status >= 400) {
        throw new RuntimeException(sprintf('%s (%s, HTTP %d)', (string) ($result['message'] ?? 'Fehler'), (string) ($result['error'] ?? '?'), $status));
    }

    return ['result' => $result, 'baseUrl' => $baseUrl];
}

/** @param array<string, mixed> $created */
function printCreatedToken(array $created, string $baseUrl): void
{
    echo 'Token-ID:  ', $created['id'], PHP_EOL;
    echo 'Name:      ', $created['name'], PHP_EOL;
    echo 'Scopes:    ', implode(' ', $created['scopes']), PHP_EOL;
    echo 'Läuft ab:  ', $created['expires_at'] === null ? 'nie' : $created['expires_at'] . ' UTC', PHP_EOL;
    echo 'Token (wird nur jetzt angezeigt):', PHP_EOL, $created['token'], PHP_EOL, PHP_EOL;
    echo 'Claude Code:', PHP_EOL;
    echo sprintf(
        'claude mcp add --transport http dispatch %s/dispatch/mcp --header "Authorization: Bearer %s"',
        rtrim($baseUrl, '/'),
        $created['token']
    ), PHP_EOL;
}

/** @param list<array<string, mixed>> $tokens */
function printTokenTable(array $tokens): void
{
    if ($tokens === []) {
        echo 'Keine Tokens.', PHP_EOL;

        return;
    }

    echo sprintf('%-4s %-20s %-30s %-20s %-10s %s', 'ID', 'Name', 'Scopes', 'Läuft ab', 'Widerrufen', 'Zuletzt benutzt'), PHP_EOL;
    foreach ($tokens as $token) {
        echo sprintf(
            '%-4d %-20s %-30s %-20s %-10s %s',
            $token['id'],
            $token['name'],
            implode(' ', $token['scopes']),
            $token['expires_at'] ?? '-',
            $token['revoked'] ? 'ja' : 'nein',
            $token['last_used_at'] ?? '-'
        ), PHP_EOL;
    }
}

/** @param array{id: int, client_id: string, client_secret: string, name: string, redirect_uris: list<string>} $client */
function printCreatedOAuthClient(array $client, string $baseUrl): void
{
    echo 'ID:           ', $client['id'], PHP_EOL;
    echo 'Name:         ', $client['name'], PHP_EOL;
    echo 'Client-ID:    ', $client['client_id'], PHP_EOL;
    echo 'Geheimnis (wird nur jetzt angezeigt):', PHP_EOL, $client['client_secret'], PHP_EOL;
    echo 'Rückadresse:  ', implode(' ', $client['redirect_uris']), PHP_EOL, PHP_EOL;
    echo 'In Claude: Connector hinzufügen → Erweiterte Einstellungen → OAuth Client ID und Client Secret eintragen.', PHP_EOL;
    echo 'Adresse: ', rtrim($baseUrl, '/'), '/dispatch/mcp', PHP_EOL;
}

/** @param list<array<string, mixed>> $clients */
function printOAuthClientTable(array $clients): void
{
    if ($clients === []) {
        echo 'Keine Rückfall-Clients.', PHP_EOL;

        return;
    }

    echo sprintf('%-4s %-20s %-36s %-20s %s', 'ID', 'Name', 'Client-ID', 'Angelegt', 'Zuletzt benutzt'), PHP_EOL;
    foreach ($clients as $client) {
        echo sprintf(
            '%-4d %-20s %-36s %-20s %s',
            $client['id'],
            $client['name'],
            $client['client_id'],
            $client['created_at'],
            $client['last_used_at'] ?? '-'
        ), PHP_EOL;
    }
}

/**
 * Trennt Argumente nach dem Befehl in Optionen (--name=wert, --flag) und freie Argumente.
 *
 * @param list<string> $arguments
 * @return array{options: array<string, string|true>, positional: list<string>}
 */
function parseArguments(array $arguments): array
{
    $options = [];
    $positional = [];
    foreach ($arguments as $argument) {
        if (!str_starts_with($argument, '--')) {
            $positional[] = $argument;
            continue;
        }
        $parts = explode('=', substr($argument, 2), 2);
        $options[$parts[0]] = $parts[1] ?? true;
    }

    return ['options' => $options, 'positional' => $positional];
}

$root = dirname(__DIR__);
$envFile = $root . '/app/.env.local';
if ((string) getenv('DISPATCH_ENV_FILE') === '' && is_file($envFile)) {
    putenv('DISPATCH_ENV_FILE=' . $envFile);
}

$config = require $root . '/app/bootstrap.php';

// Der JSON-Handler aus bootstrap.php passt nicht zur Konsole.
set_exception_handler(static function (Throwable $exception): void {
    fwrite(STDERR, 'Fehler: ' . $exception->getMessage() . PHP_EOL);
    exit(1);
});

$help = <<<'TXT'
Aufruf: php bin/dispatch <befehl>

Befehle:
  hash-password   liest eine Zeile von STDIN und gibt den Passwort-Hash aus
  migrate         wendet neue Migrationen aus app/migrations/ an
  seed            legt fehlende Einstellungen und Startdokumente an (Vorhandenes bleibt)
  demo            legt Demo-Kategorien und 15 freigegebene Beispielartikel an (nur lokal, nur auf leerer
                  Datenbank; --force legt trotzdem einen weiteren Satz an)
  build           baut die statische Website aus den Live-Ständen in die Webroot (löscht nur, was im Manifest steht)
  token:create <name> [--scopes=blog:read,blog:write] [--days=N] [--remote]
                  legt ein MCP-Token an und zeigt den Klartext einmalig (--remote: auf dem Server über deploy.env)
  token:list [--remote]
                  zeigt die MCP-Tokens ohne Hash
  token:revoke <id> [--remote]
                  widerruft ein MCP-Token
  oauth-client:create <name> [--remote]
                  legt einen Rückfall-Client für Claude-Apps an (ohne CIMD); Geheimnis wird einmalig gezeigt
  oauth-client:list [--remote]
                  zeigt die Rückfall-Clients ohne Geheimnis
  oauth-client:revoke <id> [--remote]
                  widerruft einen Rückfall-Client samt aller seiner Tokens
  category:create <slug> <name> [--description=…] [--remote]
                  legt eine aktive Kategorie als Inhaber an (--remote: auf dem Server über deploy.env)
  category:delete <slug> [--move-to=<slug>]
                  löscht eine Kategorie lokal; zugeordnete Artikel brauchen eine Ersatz-Kategorie (--move-to).
                  Auf dem Server löscht der Inhaber im Redaktionsmodus.
  reaction <slug> more|less|none [Notiz]
                  setzt oder löscht „Mehr davon / Weniger“ für einen Artikel

TXT;

$command = $argv[1] ?? '';

switch ($command) {
    case 'hash-password':
        $line = fgets(STDIN);
        $password = $line === false ? '' : rtrim($line, "\r\n");
        if ($password === '') {
            throw new RuntimeException('Kein Passwort auf STDIN gelesen. Beispiel: echo geheim | php bin/dispatch hash-password');
        }
        echo password_hash($password, PASSWORD_DEFAULT), PHP_EOL;
        break;

    case 'migrate':
        $applied = (new Migrator(Connection::open(), (string) $config['app_dir'] . '/migrations'))->run();
        if ($applied === []) {
            echo 'Nichts zu tun.', PHP_EOL;
        }
        foreach ($applied as $filename) {
            echo $filename, PHP_EOL;
        }
        break;

    case 'seed':
        $created = (new Seeder(Connection::open(), $config))->run(Actor::cli());
        if ($created === []) {
            echo 'Nichts zu tun.', PHP_EOL;
        }
        foreach ($created as $key) {
            echo $key, PHP_EOL;
        }
        break;

    case 'demo':
        runDemo(Connection::open(), $config, __DIR__ . '/demo', in_array('--force', $argv, true));
        break;

    case 'build':
        $result = (new Builder($config, Connection::open()))->build();
        echo sprintf(
            'geschrieben: %d, unverändert: %d, gelöscht: %d, Dauer: %d ms',
            $result['written'],
            $result['unchanged'],
            $result['deleted'],
            $result['ms']
        ), PHP_EOL;
        break;

    case 'token:create':
        ['options' => $options, 'positional' => $positional] = parseArguments(array_slice($argv, 2));
        $tokenName = $positional[0] ?? '';
        if ($tokenName === '') {
            throw new RuntimeException('Name fehlt. Beispiel: php bin/dispatch token:create claude-code');
        }
        $scopeOption = is_string($options['scopes'] ?? null) ? $options['scopes'] : 'blog:read,blog:write';
        $daysOption = null;
        if (isset($options['days'])) {
            $daysText = (string) $options['days'];
            if (preg_match('/^\d+$/', $daysText) !== 1) {
                throw new RuntimeException('--days braucht eine ganze Zahl, z. B. --days=30.');
            }
            $daysOption = (int) $daysText;
        }

        if (isset($options['remote'])) {
            $reply = callTokenEndpoint($root . '/deploy.env', [
                'action' => 'create',
                'name' => $tokenName,
                'scopes' => Scopes::parse($scopeOption),
                'expires_days' => $daysOption,
            ]);
            printCreatedToken($reply['result'], $reply['baseUrl']);
            break;
        }
        $created = (new TokenService(Connection::open()))->create($tokenName, $scopeOption, $daysOption, Actor::cli());
        printCreatedToken($created, (string) $config['base_url']);
        break;

    case 'token:list':
        ['options' => $options] = parseArguments(array_slice($argv, 2));
        if (isset($options['remote'])) {
            $tokens = callTokenEndpoint($root . '/deploy.env', ['action' => 'list'])['result']['tokens'];
        } else {
            $tokens = (new TokenService(Connection::open()))->list();
        }
        printTokenTable($tokens);
        break;

    case 'token:revoke':
        ['options' => $options, 'positional' => $positional] = parseArguments(array_slice($argv, 2));
        if (preg_match('/^\d+$/', $positional[0] ?? '') !== 1) {
            throw new RuntimeException('ID fehlt. Beispiel: php bin/dispatch token:revoke 3 (IDs: token:list)');
        }
        $tokenId = (int) $positional[0];
        if (isset($options['remote'])) {
            callTokenEndpoint($root . '/deploy.env', ['action' => 'revoke', 'id' => $tokenId]);
        } else {
            (new TokenService(Connection::open()))->revoke($tokenId, Actor::cli());
        }
        echo 'Token ', $tokenId, ' widerrufen.', PHP_EOL;
        break;

    case 'oauth-client:create':
        ['options' => $options, 'positional' => $positional] = parseArguments(array_slice($argv, 2));
        $clientName = $positional[0] ?? '';
        if ($clientName === '') {
            throw new RuntimeException('Name fehlt. Beispiel: php bin/dispatch oauth-client:create claude-app');
        }
        if (isset($options['remote'])) {
            $reply = callDeployEndpoint($root . '/deploy.env', '/dispatch/api/oauth-clients', ['name' => $clientName]);
            printCreatedOAuthClient($reply['result'], $reply['baseUrl']);
            break;
        }
        $createdClient = (new ClientRegistry(Connection::open(), $config))->createManual($clientName, Actor::cli());
        printCreatedOAuthClient($createdClient, (string) $config['base_url']);
        break;

    case 'oauth-client:list':
        ['options' => $options] = parseArguments(array_slice($argv, 2));
        if (isset($options['remote'])) {
            $clients = callDeployEndpoint($root . '/deploy.env', '/dispatch/api/oauth-clients', [], 'GET')['result']['clients'];
        } else {
            $clients = (new ClientRegistry(Connection::open(), $config))->listManual();
        }
        printOAuthClientTable($clients);
        break;

    case 'oauth-client:revoke':
        ['options' => $options, 'positional' => $positional] = parseArguments(array_slice($argv, 2));
        if (preg_match('/^\d+$/', $positional[0] ?? '') !== 1) {
            throw new RuntimeException('ID fehlt. Beispiel: php bin/dispatch oauth-client:revoke 2 (IDs: oauth-client:list)');
        }
        $clientRowId = (int) $positional[0];
        if (isset($options['remote'])) {
            callDeployEndpoint($root . '/deploy.env', '/dispatch/api/oauth-clients/' . $clientRowId, [], 'DELETE');
        } else {
            (new ClientRegistry(Connection::open(), $config))->revokeManual($clientRowId, Actor::cli());
        }
        echo 'Rückfall-Client ', $clientRowId, ' widerrufen.', PHP_EOL;
        break;

    case 'category:create':
        ['options' => $options, 'positional' => $positional] = parseArguments(array_slice($argv, 2));
        if (count($positional) < 2) {
            throw new RuntimeException('Aufruf: php bin/dispatch category:create <slug> <name> [--description=Text] [--remote]');
        }
        $categoryFields = ['slug' => $positional[0], 'name' => implode(' ', array_slice($positional, 1)), 'active' => true];
        if (is_string($options['description'] ?? null)) {
            $categoryFields['description'] = $options['description'];
        }
        if (isset($options['remote'])) {
            $categoryResult = callDeployEndpoint($root . '/deploy.env', '/dispatch/api/categories', $categoryFields)['result'];
            $categoryRecord = $categoryResult['category'];
        } else {
            $categoryRecord = (new CategoryService(Connection::open(), $config))->create($categoryFields, Actor::owner())['category'];
        }
        echo 'Kategorie angelegt: ', $categoryRecord['slug'], ' (ID ', $categoryRecord['id'], ')', PHP_EOL;
        break;

    case 'category:delete':
        ['options' => $options, 'positional' => $positional] = parseArguments(array_slice($argv, 2));
        if (count($positional) !== 1) {
            throw new RuntimeException('Aufruf: php bin/dispatch category:delete <slug> [--move-to=<slug>]');
        }
        if (isset($options['remote'])) {
            throw new RuntimeException('category:delete gibt es nur lokal. Auf dem Server löscht der Inhaber im Redaktionsmodus (Dialog „Deine Interessen“).');
        }
        $categoryService = new CategoryService(Connection::open(), $config);
        $deletedCategory = $categoryService->get($positional[0]);
        $moveToCategory = null;
        if (is_string($options['move-to'] ?? null)) {
            $moveToCategory = $categoryService->get($options['move-to']);
        }
        $deleteResult = $categoryService->delete((int) $deletedCategory['id'], $moveToCategory === null ? null : (int) $moveToCategory['id'], Actor::owner());
        echo 'Kategorie gelöscht: ', $deletedCategory['slug'];
        if ($deleteResult['moved'] > 0) {
            echo ' (', $deleteResult['moved'], ' Artikel umgehängt, Ersatz: ', $moveToCategory['slug'] ?? '-', ')';
        }
        echo PHP_EOL, 'Website neu bauen: php bin/dispatch build', PHP_EOL;
        break;

    case 'reaction':
        $slug = $argv[2] ?? '';
        $reactionName = $argv[3] ?? '';
        $reactionNote = isset($argv[4]) ? implode(' ', array_slice($argv, 4)) : null;
        if ($slug === '' || !in_array($reactionName, ['more', 'less', 'none'], true)) {
            throw new RuntimeException('Aufruf: php bin/dispatch reaction <slug> more|less|none [Notiz]');
        }
        $reactionPdo = Connection::open();
        try {
            $reactionPostId = (int) (new PostService($reactionPdo, $config))->getBySlug($slug)['id'];
        } catch (DomainError $error) {
            throw new RuntimeException($error->getMessage());
        }
        (new ReactionService($reactionPdo))->set($reactionPostId, $reactionName === 'none' ? null : $reactionName, $reactionNote, Actor::cli());
        echo $reactionName === 'none' ? 'Reaktion gelöscht: ' : 'Reaktion gesetzt (' . $reactionName . '): ', $slug, PHP_EOL;
        break;

    default:
        fwrite(STDERR, $help);
        exit(1);
}
