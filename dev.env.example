# Vorlage für die lokale Entwicklung: kopieren nach app/.env.local
DISPATCH_BASE_URL='http://localhost:8080'
DISPATCH_DB_HOST='localhost'
DISPATCH_DB_NAME='dispatch_dev'
DISPATCH_DB_USER='dispatch'
DISPATCH_DB_PASSWORD=''
DISPATCH_DEPLOY_TOKEN=''
# Anmeldung des Inhabers (Redaktionsmodus). Hash: echo <passwort>| php bin/dispatch hash-password
DISPATCH_OWNER_USER=''
DISPATCH_OWNER_PASSWORD_HASH=''
# mindestens 64 Hex-Zeichen: php -r "echo bin2hex(random_bytes(32));"
DISPATCH_JWT_SECRET=''
# nur lokal: Refresh-Cookie ohne Secure, damit er auf http://localhost ankommt. Auf Strato nie setzen.
DISPATCH_INSECURE_COOKIES='1'
# Absoluter Pfad zum lokalen public/
DISPATCH_WEB_ROOT=''
# nur lokal: erlaubt Abrufe an private Adressen (SSRF-Schutz aus). Auf Strato nie setzen.
DISPATCH_ALLOW_PRIVATE_IPS=''
