# Kopiere diese Datei nach "deploy.env" und trage deine Werte ein.
# deploy.env landet NICHT im Git - sie enthaelt Klartext-Zugangsdaten.
#
# Sonderzeichen im Passwort sind in Ordnung - das Skript reicht Benutzer und Passwort
# als eigene Angaben an WinSCP weiter, nicht als Teil einer Adresse.
# Einzige Ausnahme: ein doppeltes Anfuehrungszeichen (") im Passwort geht nicht.

# -- Hochladen ----------------------------------------------------------------
# Pfad zur portablen WinSCP-Konsole (nicht WinSCP.exe, sondern WinSCP.com).
WINSCP_PATH=H:\Meine Ablage\U600_Software\WinSCP-6.5.1-Portable\WinSCP.com

# sftp oder ftp. Bei ftp wird SFTP_HOSTKEY nicht gebraucht und darf leer bleiben.
SFTP_PROTOCOL=sftp
SFTP_HOST=
SFTP_USER=
SFTP_PASSWORD=

# Nur bei sftp noetig. Format ohne "SHA256:"-Praefix, genau so wie WinSCP es meldet:
#   ssh-ed25519 255 1gx2w8Rtv3wCgi7Jh8myf...
# So kommst du dran: WinSCP von Hand verbinden, dann Strg+I ("Server- und
# Protokollinformationen") und den Fingerabdruck kopieren. Alternativ einmal mit
# irgendeinem Wert (nicht *) hier starten - WinSCP bricht ab und nennt den echten Abdruck.
# Kein Stern als Platzhalter - der wuerde jeden Server akzeptieren, der sich fuer
# deinen ausgibt; das Skript lehnt ihn ab.
SFTP_HOSTKEY=

# Der Ordner, den der SFTP-Login als "www/" sieht, mit Schraegstrich am Ende.
# Daraus leiten sich ab: <Wurzel>dispatch/ (Bruecke), <Wurzel>dispatch-app/ (Code)
# und <Wurzel>.htaccess. Die alte .htaccess wird vor dem Ueberschreiben nach
# deploy-backup\root.htaccess gesichert.
REMOTE_WEB_ROOT=/

# -- Pruefen ------------------------------------------------------------------
# Optional: PHP fuer "php -l" ueber app/, bridge/ und bin/ vor dem Hochladen.
PHP_PATH=C:\Users\sasch\develop\.tools\php\php.exe

# Adresse der Domain ohne Schraegstrich am Ende.
PUBLIC_BASE_URL=https://quantum-canvas.de

# Adressen fremder Anwendungen im selben Webroot, durch Leerzeichen getrennt.
# Der Rauchtest erwartet auf jeder Status 200.
NEIGHBOR_URLS=/card/ /scanner/capture

# -- Wird nach app/.env geschrieben --------------------------------------------
DISPATCH_DB_HOST=
DISPATCH_DB_NAME=
DISPATCH_DB_USER=
DISPATCH_DB_PASSWORD=

# Nur Buchstaben und Ziffern. Schuetzt /dispatch/api/deploy und /dispatch/api/diag.
# Erzeugen: php -r "echo bin2hex(random_bytes(32));"
DISPATCH_DEPLOY_TOKEN=

# Anmeldung des Inhabers auf der Website (Redaktionsmodus).
# Benutzername: frei waehlbar, ohne einfaches Anfuehrungszeichen.
DISPATCH_OWNER_USER=
# Passwort-Hash (bcrypt), nie das Passwort selbst. Erzeugen:
#   echo <passwort>| php bin/dispatch hash-password
# Der Hash enthaelt $ - hier unveraendert und ohne Anfuehrungszeichen einfuegen.
DISPATCH_OWNER_PASSWORD_HASH=
# Mindestens 64 Hex-Zeichen. Erzeugen: php -r "echo bin2hex(random_bytes(32));"
DISPATCH_JWT_SECRET=
